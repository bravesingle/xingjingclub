/* pages/index/index.wxss —— 仅首页私有样式，其余复用 app.wxss */

.banner {
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  position: relative;
  overflow: hidden;
}

.banner-item::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: linear-gradient(180deg, rgba(15, 18, 34, 0), rgba(15, 18, 34, 0.72));
  z-index: 1;
}

/* banner 图片：有图优先铺满 */
.banner-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.banner-title {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  position: relative;
  z-index: 2;
}

.banner-subtitle {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-top: 8rpx;
  position: relative;
  z-index: 2;
}

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.cat-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  box-sizing: border-box;
}
.cat-item:active { opacity: 0.82; }

.cat-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--bg-card-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.cat-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-main);
  max-width: 128rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loading-tip {
  text-align: center;
  color: var(--text-dim);
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* 热门区标题行：标题 + 查看全部入口 */
.section-head {
  margin-top: 32rpx;
}
.section-head .section-title {
  margin: 0 0 20rpx;
}
.view-all {
  color: var(--text-sub);
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.brand-foot {
  text-align: center;
  padding: 56rpx 0 24rpx;
}

.brand-name {
  font-size: 26rpx;
  color: var(--text-sub);
}

.brand-slogan {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-top: 8rpx;
}
