/* pages/login/login.wxss 登录页私有样式 */

.login-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 28rpx calc(200rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background:
    radial-gradient(circle at 22% 8%, rgba(99, 230, 247, 0.20), transparent 30%),
    radial-gradient(circle at 86% 14%, rgba(139, 92, 246, 0.24), transparent 34%),
    radial-gradient(circle at 50% 100%, rgba(248, 199, 107, 0.10), transparent 34%);
}

@keyframes starTwinkle {
  0%, 100% {
    opacity: 0.42;
    transform: scale(0.86);
  }
  45% {
    opacity: 1;
    transform: scale(1.14);
  }
}

@keyframes starFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

@keyframes shootingMove {
  0% {
    opacity: 0;
    transform: translate3d(100rpx, -40rpx, 0) rotate(-22deg);
  }
  14% {
    opacity: 0.78;
  }
  42% {
    opacity: 0;
    transform: translate3d(-220rpx, 100rpx, 0) rotate(-22deg);
  }
  100% {
    opacity: 0;
    transform: translate3d(-220rpx, 100rpx, 0) rotate(-22deg);
  }
}

@keyframes markGlow {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
    box-shadow: 0 22rpx 60rpx rgba(99, 230, 247, 0.16);
  }
  50% {
    transform: translateY(-8rpx) rotate(6deg);
    box-shadow: 0 28rpx 78rpx rgba(99, 230, 247, 0.28);
  }
}

.sky-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.star {
  position: absolute;
  color: rgba(244, 247, 251, 0.88);
  text-shadow: 0 0 18rpx rgba(99, 230, 247, 0.7);
  animation: starTwinkle 3.6s ease-in-out infinite;
}

.star-a { top: 62rpx; left: 68rpx; font-size: 30rpx; }
.star-b { top: 168rpx; right: 62rpx; font-size: 38rpx; color: rgba(248, 199, 107, 0.92); animation-delay: 0.4s; }
.star-c { top: 432rpx; left: 42rpx; font-size: 24rpx; color: rgba(99, 230, 247, 0.82); animation-delay: 1.1s; }
.star-d { top: 572rpx; right: 86rpx; font-size: 26rpx; animation-delay: 1.7s; }
.star-e { top: 256rpx; left: 122rpx; font-size: 20rpx; color: rgba(139, 92, 246, 0.86); animation-delay: 2.2s; }
.star-f { top: 360rpx; right: 34rpx; font-size: 22rpx; animation-delay: 0.9s; }
.star-g { top: 686rpx; left: 54rpx; font-size: 30rpx; color: rgba(248, 199, 107, 0.78); animation-delay: 1.4s; }
.star-h { top: 908rpx; right: 48rpx; font-size: 20rpx; color: rgba(99, 230, 247, 0.80); animation-delay: 2.7s; }

.shooting-star {
  position: absolute;
  width: 130rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, rgba(244, 247, 251, 0.88), transparent);
  transform: rotate(-22deg);
  opacity: 0.72;
  box-shadow: 0 0 18rpx rgba(99, 230, 247, 0.36);
  animation: shootingMove 5.8s ease-in-out infinite;
}

.shooting-a { top: 214rpx; left: 320rpx; }
.shooting-b { top: 792rpx; left: 118rpx; width: 96rpx; opacity: 0.46; animation-delay: 2.6s; }

.star-dot {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(244, 247, 251, 0.88);
  box-shadow: 0 0 16rpx rgba(244, 247, 251, 0.65);
  animation: starTwinkle 4.6s ease-in-out infinite;
}

.dot-a { top: 118rpx; left: 246rpx; }
.dot-b { top: 284rpx; right: 176rpx; width: 8rpx; height: 8rpx; background: var(--primary); }
.dot-c { top: 720rpx; left: 144rpx; animation-delay: 0.8s; }
.dot-d { top: 832rpx; right: 232rpx; background: var(--gold); animation-delay: 1.3s; }
.dot-e { top: 72rpx; right: 228rpx; width: 4rpx; height: 4rpx; animation-delay: 2.1s; }
.dot-f { top: 238rpx; left: 38rpx; width: 5rpx; height: 5rpx; background: rgba(139, 92, 246, 0.90); animation-delay: 2.8s; }
.dot-g { top: 394rpx; left: 286rpx; width: 4rpx; height: 4rpx; animation-delay: 1.9s; }
.dot-h { top: 508rpx; right: 188rpx; width: 6rpx; height: 6rpx; background: var(--primary); animation-delay: 3.2s; }
.dot-i { top: 624rpx; left: 316rpx; width: 5rpx; height: 5rpx; animation-delay: 0.5s; }
.dot-j { top: 756rpx; right: 54rpx; width: 4rpx; height: 4rpx; animation-delay: 2.5s; }
.dot-k { top: 944rpx; left: 236rpx; width: 7rpx; height: 7rpx; background: rgba(248, 199, 107, 0.92); animation-delay: 1.6s; }
.dot-l { top: 1040rpx; right: 132rpx; width: 4rpx; height: 4rpx; animation-delay: 3.6s; }
 
.brand-area,
.login-card,
.agree-row,
.footer-bar {
  position: relative;
  z-index: 1;
}

/* 品牌区 */
.brand-area {
  padding: 72rpx 0 44rpx;
  text-align: center;
  animation: fadeUp 0.62s ease both;
}

.brand-mark {
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-size: 48rpx;
  background: linear-gradient(145deg, rgba(99, 230, 247, 0.18), rgba(139, 92, 246, 0.20));
  border: 2rpx solid rgba(99, 230, 247, 0.26);
  box-shadow: 0 22rpx 60rpx rgba(99, 230, 247, 0.16);
  animation: markGlow 4.8s ease-in-out infinite;
}

.brand-title {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: 4rpx;
  text-shadow: 0 0 28rpx rgba(99, 230, 247, 0.24);
}

.brand-slogan {
  margin-top: 14rpx;
  letter-spacing: 3rpx;
}

/* 表单卡 */
.login-card {
  padding: 36rpx 32rpx 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(22, 32, 52, 0.92), rgba(13, 19, 32, 0.94));
  border: 2rpx solid rgba(99, 230, 247, 0.18);
  box-shadow: 0 30rpx 70rpx rgba(0, 0, 0, 0.30);
  animation: fadeUp 0.72s ease 0.08s both;
}

.login-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.login-eyebrow {
  color: var(--primary);
  font-size: 20rpx;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.login-label {
  font-size: 40rpx;
  font-weight: 700;
}

.mini-star {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold);
  background: rgba(248, 199, 107, 0.12);
  animation: starFloat 3.2s ease-in-out infinite;
}

.login-tip {
  margin: 12rpx 0 30rpx;
  line-height: 1.7;
}

.login-input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.055);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.login-input + .login-input {
  margin-top: 20rpx;
}

.input-placeholder {
  color: var(--text-dim);
}

.login-perks {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.login-perks text {
  padding: 8rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  color: var(--primary);
  font-size: 22rpx;
  background: rgba(99, 230, 247, 0.10);
  border: 2rpx solid rgba(99, 230, 247, 0.10);
}

/* 协议行 */
.agree-row {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
  padding: 0 10rpx;
  animation: fadeUp 0.72s ease 0.16s both;
}

.agree-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  background: rgba(255, 255, 255, 0.06);
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.agree-check-on {
  border-color: var(--primary);
  background: linear-gradient(135deg, var(--primary), var(--primary-2));
}

.agree-check-mark {
  color: #07111D;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
}

.agree-link {
  color: var(--primary);
}

.login-desc {
  margin: 12rpx 8rpx 0;
  font-size: 22rpx;
  line-height: 1.7;
}

/* ============ 微信一键登录按钮（button 组件需重置默认样式） ============ */
.login-btn {
  width: 100%;
  padding: 0;
  margin: 0;
  border: none;
  font-size: 30rpx;
  line-height: normal;
  overflow: visible;
}

.login-btn::after {
  border: none;
}

/* disabled 时保持金色底（原生 button 默认会把禁用态变灰） */
.login-btn[disabled] {
  color: #1A1020;
  background: linear-gradient(135deg, #F8C76B, #FF7A90);
  opacity: 0.5;
}
