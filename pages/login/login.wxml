<!-- pages/login/login.wxml 登录页 -->
<view class="page login-page">
  <!-- ① 品牌区 -->
  <view class="brand-area">
    <view class="brand-title">{{brand}}</view>
    <view class="brand-slogan text-sub">{{brandSlogan}}</view>
  </view>

  <!-- ② 资料卡（昵称/游戏ID 选填，一键登录后自动创建账号） -->
  <view class="card login-card">
    <view class="login-label">手机号快捷登录</view>
    <view class="login-tip text-dim">授权手机号即可快速开始服务</view>
    <input class="form-input login-input" placeholder="请输入昵称（选填）" placeholder-class="input-placeholder" value="{{nickname}}" bindinput="onNicknameInput" maxlength="20" />
    <input class="form-input login-input" placeholder="请输入游戏ID（选填）" placeholder-class="input-placeholder" value="{{gameId}}" bindinput="onGameIdInput" maxlength="30" />
    <view class="login-desc text-dim">手机号仅用于订单联系与身份核验</view>
  </view>

  <!-- ③ 协议行 -->
  <view class="agree-row">
    <view class="agree-check {{agree ? 'agree-check-on' : ''}}" bindtap="onToggleAgree">
      <text wx:if="{{agree}}" class="agree-check-mark">✓</text>
    </view>
    <view class="agree-text text-dim">
      <text>我已阅读并同意</text>
      <text class="agree-link" catchtap="onAgreementTap" data-type="user">《用户协议》</text>
      <text>与</text>
      <text class="agree-link" catchtap="onAgreementTap" data-type="privacy">《隐私政策》</text>
    </view>
  </view>

  <!-- ④ 底部操作栏：getPhoneNumber 一键授权手机号 -->
  <view class="footer-bar">
    <button
      class="btn btn-gold login-btn {{agree && !submitting ? '' : 'btn-disabled'}}"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      disabled="{{!agree || submitting}}"
    >{{submitting ? '登录中...' : '手机号快捷登录'}}</button>
  </view>
</view>
