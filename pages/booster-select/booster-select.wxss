/* pages/booster-select/booster-select.wxss */

.select-page {
  min-height: 100vh;
  padding-bottom: 56rpx;
}

.search-card {
  display: flex;
  align-items: center;
  padding: 16rpx 18rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(24, 34, 56, 0.94), rgba(17, 24, 39, 0.94));
  border: 2rpx solid rgba(99, 230, 247, 0.16);
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.22);
}

.search-icon {
  width: 52rpx;
  color: var(--primary);
  font-size: 34rpx;
  text-align: center;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  color: var(--text-main);
  font-size: 28rpx;
}

.search-placeholder {
  color: var(--text-dim);
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-dim);
  font-size: 34rpx;
}

.search-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  color: #07111D;
  font-size: 24rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #63E6F7, #8B5CF6);
}

.select-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 34rpx 4rpx 18rpx;
}

.title-main {
  font-size: 38rpx;
  font-weight: 800;
}

.title-sub {
  margin-top: 6rpx;
  color: var(--text-dim);
  font-size: 24rpx;
}

.title-star {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold);
  background: rgba(248, 199, 107, 0.12);
  box-shadow: 0 0 28rpx rgba(248, 199, 107, 0.12);
}

.booster-card {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(99, 230, 247, 0.12), transparent 34%),
    linear-gradient(180deg, rgba(24, 34, 56, 0.96), rgba(17, 24, 39, 0.96));
  border: 2rpx solid rgba(99, 230, 247, 0.12);
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.20);
  animation: fadeUp 0.42s ease both;
}

.booster-card:active {
  transform: scale(0.988);
}

.avatar-wrap,
.avatar-img,
.avatar-fallback {
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}

.avatar-wrap {
  margin-right: 22rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #63E6F7, #8B5CF6);
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #07111D;
  font-size: 42rpx;
  font-weight: 800;
}

.booster-info {
  flex: 1;
  min-width: 0;
}

.booster-top {
  display: flex;
  align-items: center;
}

.booster-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 800;
}

.status-pill {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-ready {
  color: #07111D;
  background: var(--primary);
}

.status-online {
  color: var(--gold);
  background: rgba(248, 199, 107, 0.14);
}

.booster-meta {
  margin-top: 8rpx;
}

.booster-tags {
  margin-top: 12rpx;
  max-height: 48rpx;
  overflow: hidden;
}

.tag-mini {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
}

.booster-remark {
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid var(--text-dim);
  border-right: 4rpx solid var(--text-dim);
  transform: rotate(45deg);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.empty-wrap,
.loading-tip {
  padding: 120rpx 0;
}
