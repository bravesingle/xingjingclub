<!-- pages/balance/balance.wxml 我的余额（余额来自退款或平台赠送，可用于支付订单） -->
<view class="page">
  <!-- 余额卡 -->
  <view class="card balance-card">
    <view class="text-sub">我的余额</view>
    <view class="price balance-amount">
      <text class="price-symbol">¥</text>
      <text class="price-num">{{balanceYuan}}</text>
    </view>
    <view class="text-dim">余额可用于支付订单</view>
  </view>

  <!-- 说明 -->
  <view class="card">
    <view class="section-title">余额说明</view>
    <view class="text-dim tip">余额来自订单退款或平台赠送，可在下单时选择余额支付抵扣订单金额。</view>
  </view>
</view>
