<!-- pages/booster-chat/booster-chat.wxml 服务消息 -->
<view class="page">
  <!-- 未登录引导 -->
  <view class="empty-wrap" wx:if="{{needLogin}}">
    <empty text="登录后查看消息" subText="与服务中的客户保持沟通" btnText="去登录" bind:action="onGoLogin" />
  </view>

  <!-- 会话列表 -->
  <view class="list" wx:elif="{{sessions.length > 0}}">
    <view class="session-card card flex" wx:for="{{sessions}}" wx:key="id" data-id="{{item.id}}" bindtap="onGoChat">
      <view class="session-cover" style="background:{{item.coverGradient}}">{{item.coverText}}</view>
      <view class="flex-1 session-info">
        <view class="flex-between">
          <view class="session-title text-ellipsis flex-1">{{item.serviceTitle}}</view>
          <text class="status-tag {{item.statusCls}}">{{item.statusText}}</text>
        </view>
        <view class="session-time text-dim">最近 {{item.recentTimeText}}</view>
      </view>
      <view class="btn btn-primary btn-sm session-btn">进入聊天</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:elif="{{!loading}}">
    <empty text="暂无进行中的订单" />
  </view>

  <!-- 加载中 -->
  <view class="loading-tip text-center text-dim" wx:else>加载中…</view>
</view>
