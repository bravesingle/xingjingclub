<!-- pages/booster-wallet/booster-wallet.wxml 保证金（收入结算由平台线下处理） -->
<view class="page safe-bottom">
  <!-- ① 保证金 -->
  <view class="section-title">保证金</view>
  <view class="card flex-between">
    <view class="flex-1">
      <view wx:if="{{wallet.deposited}}" class="text-success text-bold">保证金已缴纳</view>
      <block wx:else>
        <view class="text-sub">未缴纳保证金</view>
        <view class="text-dim deposit-tip">保证金 ¥{{depositAmount}}，缴纳后即可开始接单</view>
      </block>
    </view>
    <view wx:if="{{!wallet.deposited}}" class="btn btn-gold btn-sm" bindtap="onPayDeposit">缴纳保证金</view>
    <view wx:else class="tag tag-green">已缴纳</view>
  </view>

  <!-- ② 说明 -->
  <view class="card">
    <view class="section-title">说明</view>
    <view class="text-dim deposit-tip">保证金用于保障服务履约；服务收入由平台统一结算，具体以平台规则为准。</view>
  </view>
</view>
