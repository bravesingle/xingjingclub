/* pages/service-detail/service-detail.wxss —— 仅详情页私有样式，其余复用 app.wxss */

.detail-page {
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.detail-page .card {
  margin-top: 20rpx;
}

.detail-cover {
  position: relative;
  height: 320rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.detail-cover::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 58%;
  background: linear-gradient(180deg, rgba(15, 18, 34, 0), rgba(15, 18, 34, 0.62));
  z-index: 1;
}

.detail-cover-img,
.detail-cover-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.detail-cover-bg {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.detail-cover-text {
  color: #FFFFFF;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  position: relative;
  z-index: 2;
}

.detail-mode {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  padding: 6rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  position: relative;
  z-index: 2;
}

.detail-info {
  margin-top: 20rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
}

.detail-subtitle {
  margin-top: 8rpx;
}

.detail-tags {
  margin-top: 16rpx;
  max-height: 88rpx;
  overflow: hidden;
}

.detail-meta {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.detail-block-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.detail-title-inline {
  margin-bottom: 0;
}

.spec-row {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.spec-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  background: var(--bg-card-2);
  border: 2rpx solid transparent;
  box-sizing: border-box;
  color: var(--text-sub);
  font-size: 26rpx;
  min-height: 104rpx;
  justify-content: center;
  text-align: center;
}

.spec-price {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-dim);
}

.spec-active {
  border-color: var(--gold);
  color: var(--gold);
  background: rgba(255, 211, 77, 0.08);
}

.spec-active .spec-price {
  color: var(--gold);
}

.rule-arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid var(--text-dim);
  border-bottom: 4rpx solid var(--text-dim);
  transform: rotate(45deg);
  transition: transform 0.2s;
}

.rule-arrow-open {
  transform: rotate(-135deg);
}

.rule-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.6;
}

.rule-item:last-child {
  margin-bottom: 0;
}

.rule-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary);
  margin: 16rpx 16rpx 0 0;
}

.rule-dot-warn {
  background: var(--gold);
}

.footer-spacer {
  height: 160rpx;
}
