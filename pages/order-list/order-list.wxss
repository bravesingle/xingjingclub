/* pages/order-list/order-list.wxss 私有样式 */

/* 顶部 tab 栏 */
.tab-scroll {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.tab-bar {
  display: inline-flex;
  min-width: 100%;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 8rpx;
  box-sizing: border-box;
}

.tab-item {
  flex: 0 0 auto;
  min-width: 112rpx;
  text-align: center;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  border-radius: 12rpx;
  white-space: nowrap;
  transition: transform 0.18s ease, color 0.18s ease;
}
.tab-item:active {
  transform: scale(0.96);
}

.tab-on {
  background: linear-gradient(135deg, #63E6F7, #8B5CF6);
  color: #07111D;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(99, 230, 247, 0.22);
  animation: glowPulse 3.6s ease-in-out infinite;
}

/* 列表间距 */
.list {
  padding-bottom: 20rpx;
}

/* 空状态 */
.empty-wrap {
  padding: 120rpx 0;
}

/* 加载中 */
.loading-tip {
  padding: 120rpx 0;
}
