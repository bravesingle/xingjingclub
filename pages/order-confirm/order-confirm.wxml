<!-- pages/order-confirm/order-confirm.wxml 确认订单 -->
<view class="page safe-bottom" wx:if="{{service && spec}}">
  <!-- ① 服务卡片 -->
  <view class="card">
    <view class="flex">
      <view class="svc-cover" style="background:{{service.coverGradient}}">{{service.coverText}}</view>
      <view class="flex-1">
        <view class="svc-title text-ellipsis">{{service.title}}</view>
        <view class="svc-sub text-sub text-ellipsis">{{service.subtitle}}</view>
        <view class="flex-between svc-bottom">
          <text class="tag tag-gold">{{spec.label}} × {{quantity}}</text>
          <view class="price">
            <text class="price-symbol">¥</text>
            <text class="price-num">{{unitPriceText}}</text>
            <text class="price-unit">/{{spec.label}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ② 数量 -->
  <view class="card">
    <view class="flex-between">
      <text class="text-main">购买数量</text>
      <stepper value="{{quantity}}" min="1" max="99" bind:change="onQuantityChange" />
    </view>
  </view>

  <!-- ③ 留言备注 -->
  <view class="card">
    <view class="remark-title text-main">留言备注</view>
    <textarea class="form-textarea" placeholder="选填：打手要求、上分目标等" maxlength="100" value="{{remark}}" bindinput="onRemarkInput" />
  </view>

  <!-- ④ 价格明细 -->
  <view class="card">
    <view class="flex-between price-row">
      <text class="text-sub">商品金额</text>
      <text class="text-main">¥{{totalText}}</text>
    </view>
    <view class="flex-between price-row">
      <text class="text-sub">优惠</text>
      <view class="flex">
        <text class="text-main">-¥0.00</text>
        <text class="text-dim coupon-tip">优惠券功能开发中</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="flex-between">
      <text class="text-bold">应付合计</text>
      <view class="price">
        <text class="price-symbol">¥</text>
        <text class="price-num total-num">{{totalText}}</text>
      </view>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="footer-placeholder"></view>

  <!-- ⑤ footer-bar -->
  <view class="footer-bar">
    <view class="btn btn-gold {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">{{submitting ? '提交中…' : '提交订单'}}</view>
  </view>
</view>
