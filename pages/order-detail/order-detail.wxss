/* pages/order-detail/order-detail.wxss 私有样式 */

/* 状态头部 */
.status-card {
  background: linear-gradient(135deg, rgba(77, 124, 255, 0.18), rgba(123, 92, 255, 0.18));
  border: 2rpx solid rgba(77, 124, 255, 0.35);
}

.status-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--gold);
  margin-right: 16rpx;
  min-width: 0;
}

.status-desc {
  margin-top: 10rpx;
}

/* 服务信息 */
.svc-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-align: center;
}

.svc-title {
  font-size: 30rpx;
  line-height: 1.35;
}

.svc-line {
  margin-top: 6rpx;
}

/* 订单信息长文本换行 */
.cell-value {
  text-align: right;
  word-break: break-all;
  max-width: 440rpx;
}

/* footer 占位 */
.footer-placeholder {
  height: 160rpx;
}
