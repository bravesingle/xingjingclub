<!-- pages/order-detail/order-detail.wxml 订单详情 -->
<view class="page safe-bottom" wx:if="{{order}}">
  <!-- ① 状态头部 -->
  <view class="status-card card">
    <view class="flex-between">
      <text class="status-title">{{statusInfo.text}}</text>
      <text class="text-dim">单号 {{order.orderNo}}</text>
    </view>
    <view class="text-sub status-desc">{{statusDesc}}</view>
  </view>

  <!-- ② 待支付倒计时 -->
  <view class="card flex-between" wx:if="{{order.status === 'pending_pay'}}">
    <view class="column">
      <text class="text-sub">支付剩余时间</text>
      <text class="text-dim">超时订单将自动取消</text>
    </view>
    <countdown endTime="{{order.payExpireAt}}" bind:finish="onCountdownFinish" />
  </view>

  <!-- ③ 服务信息 -->
  <view class="card">
    <view class="flex">
      <view class="svc-cover" style="background:{{order.coverGradient}}">{{order.coverText}}</view>
      <view class="flex-1">
        <view class="text-bold svc-title text-ellipsis">{{order.serviceTitle}}</view>
        <view class="text-sub svc-line">{{order.specLabel}} × {{order.quantity}}</view>
        <view class="text-dim svc-line">{{order.modeName}}</view>
      </view>
    </view>
    <view class="divider"></view>
    <view class="flex-between">
      <text class="text-sub">实付金额</text>
      <view class="price">
        <text class="price-symbol">¥</text>
        <text class="price-num">{{amountText}}</text>
      </view>
    </view>
  </view>

  <!-- ④ 订单信息 -->
  <view class="card">
    <view class="cell">
      <text class="text-sub">订单编号</text>
      <text class="text-main">{{order.orderNo}}</text>
    </view>
    <view class="cell">
      <text class="text-sub">下单时间</text>
      <text class="text-main">{{createdAtText}}</text>
    </view>
    <view class="cell" wx:if="{{paidAtText}}">
      <text class="text-sub">支付时间</text>
      <text class="text-main">{{paidAtText}}</text>
    </view>
    <view class="cell" wx:if="{{order.remark}}">
      <text class="text-sub">留言备注</text>
      <text class="text-main cell-value">{{order.remark}}</text>
    </view>
    <view class="cell" wx:if="{{order.refundReason}}">
      <text class="text-sub">退款原因</text>
      <text class="text-main cell-value">{{order.refundReason}}</text>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="footer-placeholder"></view>

  <!-- ⑤ 状态操作（玩家视角） -->
  <view class="footer-bar" wx:if="{{!isBooster}}">
    <block wx:if="{{order.status === 'pending_pay'}}">
      <view class="btn btn-ghost" bindtap="onCancelOrder">取消订单</view>
      <view class="btn btn-primary" bindtap="onGoPay">去支付</view>
    </block>
    <block wx:elif="{{order.status === 'paid'}}">
      <view class="btn btn-ghost" bindtap="onRefund">申请退款</view>
      <view class="btn btn-primary" bindtap="onContact">联系客服</view>
    </block>
    <block wx:elif="{{order.status === 'in_progress'}}">
      <view class="btn btn-ghost" bindtap="onContact">联系客服</view>
      <view class="btn btn-primary" bindtap="onComplete">确认完成</view>
    </block>
    <block wx:elif="{{order.status === 'completed'}}">
      <view class="btn btn-ghost" bindtap="onRefund">申请退款(售后)</view>
      <view class="btn btn-primary" bindtap="onAgain">再来一单</view>
    </block>
    <block wx:else>
      <view class="btn btn-ghost" bindtap="onContact">联系客服</view>
    </block>
  </view>

  <!-- ⑥ 打手视角操作：进入聊天 + 联系客服 -->
  <view class="footer-bar" wx:else>
    <view class="btn btn-ghost" bindtap="onContact">联系客服</view>
    <view class="btn btn-gold" bindtap="onGoChat">进入聊天</view>
  </view>
</view>
