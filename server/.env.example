# ===== 服务 =====
PORT=3000
NODE_ENV=development

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=xingjing123
DB_DATABASE=xingjing
# 表结构：开发 true 自动建表；生产必须 false（改用 migration）
DB_SYNCHRONIZE=true

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT =====
# 生产环境 NODE_ENV=production 时强制要求：至少 32 位且不得为下方弱默认值
JWT_SECRET=xingjing-esports-change-me
JWT_EXPIRES_IN=7d

# ===== CORS（管理后台域名白名单，逗号分隔；小程序原生请求无 Origin 自动放行）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 微信登录（未配置 appid/secret 时自动走 mock，openid 由 code 本地派生）=====
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK=true

# ===== 微信支付（APIv3 直连 JSAPI，PAY_MOCK=false 时启用）=====
# 需在商户平台「账户中心-API安全」申请：APIv3密钥、商户API证书(apiclient_key.pem/apiclient_cert.pem)
WXPAY_MCHID=                # 商户号（直连商户）
WXPAY_SERIAL_NO=            # 商户API证书序列号（商户平台可查）
WXPAY_APIV3_KEY=            # APIv3 密钥（32位）
WXPAY_PRIVATE_KEY=certs/apiclient_key.pem   # 证书私钥路径（相对 server/ 运行目录）
WXPAY_PUBLIC_KEY=certs/wechatpay_pub.pem    # 微信支付平台公钥路径（回调验签）
WXPAY_PUB_KEY_ID=           # 平台公钥ID（可选，用于校验回调 Wechatpay-Serial）
WXPAY_NOTIFY_URL=           # 支付结果回调地址，必须公网 HTTPS，如 https://<你的域名>/api/pay/wechat/notify

# ===== 支付（true 时支付接口走本地模拟，不请求微信支付）=====
# 正式上线必须接入微信支付并设为 false，否则充值/押金/支付接口会被禁用（防免费入账）
PAY_MOCK=true
PAY_EXPIRE_MINUTES=15
