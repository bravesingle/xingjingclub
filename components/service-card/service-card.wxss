.scard {
  padding: 0;
  overflow: hidden;
  margin-top: 20rpx;
}
.scard-cover {
  position: relative;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.scard-cover::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70%;
  background: linear-gradient(180deg, rgba(15, 18, 34, 0), rgba(15, 18, 34, 0.64));
  z-index: 1;
}
.scard-cover-img,
.scard-cover-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.scard-cover-bg {
  display: flex;
  align-items: center;
  justify-content: center;
}
.scard-cover-text {
  font-size: 40rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 4rpx;
  position: relative;
  z-index: 2;
}
.scard-mode {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.42);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  z-index: 2;
}
.scard-body {
  padding: 20rpx 24rpx 24rpx;
}
.scard-title {
  font-size: 32rpx;
  font-weight: 600;
}
.scard-subtitle {
  color: var(--text-sub);
  font-size: 24rpx;
  margin-top: 6rpx;
}
.scard-tags {
  margin-top: 14rpx;
  max-height: 48rpx;
  overflow: hidden;
}
.tag-mini {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  margin-right: 10rpx;
}
.scard-foot {
  margin-top: 16rpx;
  align-items: flex-end;
}
.scard-meta {
  color: var(--text-dim);
  font-size: 22rpx;
  margin-left: 16rpx;
  white-space: nowrap;
}
