.ocard {
  margin-top: 20rpx;
}
.ocard-no {
  font-size: 22rpx;
}
.ocard-main {
  margin-top: 20rpx;
  align-items: flex-start;
}
.ocard-cover {
  width: 120rpx;
  height: 90rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.ocard-info {
  margin-left: 20rpx;
}
.ocard-title {
  font-size: 30rpx;
  font-weight: 600;
}
.ocard-info .text-sub {
  margin-top: 8rpx;
}
.ocard-info .price {
  margin-top: 10rpx;
  display: inline-flex;
  align-items: baseline;
}
.ocard-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}
.ocard-actions .btn + .btn {
  margin-left: 16rpx;
}
