<view class="ocard card" bindtap="onDetail">
  <view class="flex-between">
    <text class="text-dim ocard-no">单号 {{order.orderNo}}</text>
    <text class="status-tag {{statusCls}}">{{statusText}}</text>
  </view>

  <view class="ocard-main flex">
    <view class="ocard-cover" style="background:{{order.coverGradient}}">{{order.coverText}}</view>
    <view class="flex-1 ocard-info">
      <view class="ocard-title text-ellipsis">{{order.serviceTitle}}</view>
      <view class="text-sub">{{order.specLabel}} × {{order.quantity}}</view>
      <view class="price">
        <text class="price-symbol">¥</text>
        <text class="price-num">{{amountText}}</text>
      </view>
    </view>
  </view>

  <view class="ocard-actions" wx:if="{{order.status === 'pending_pay' || order.status === 'paid' || order.status === 'in_progress' || order.status === 'completed'}}">
    <view class="btn btn-ghost btn-sm" wx:if="{{order.status === 'pending_pay'}}" catchtap="onCancel">取消订单</view>
    <view class="btn btn-primary btn-sm" wx:if="{{order.status === 'pending_pay'}}" catchtap="onPay">去支付</view>
    <view class="btn btn-ghost btn-sm" wx:if="{{order.status === 'paid' || order.status === 'in_progress'}}" catchtap="onContact">联系客服</view>
    <view class="btn btn-primary btn-sm" wx:if="{{order.status === 'completed'}}" catchtap="onAgain">再来一单</view>
  </view>
</view>
