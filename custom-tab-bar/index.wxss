/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #141830;
  border-top: 2rpx solid #262d4f;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}
.tab-text {
  font-size: 22rpx;
  color: #8a8fa3;
  margin-top: 6rpx;
}
.tab-item.active .tab-text {
  color: #ffd34d;
}
