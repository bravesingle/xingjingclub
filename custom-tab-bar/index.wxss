/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: rgba(13, 19, 32, 0.96);
  border-top: 2rpx solid #29364f;
  box-shadow: 0 -18rpx 40rpx rgba(0, 0, 0, 0.28);
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease;
}
.tab-item:active {
  transform: translateY(-4rpx);
}
.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}
.tab-text {
  font-size: 22rpx;
  color: #8f9ab0;
  margin-top: 6rpx;
}
.tab-item.active .tab-text {
  color: #63e6f7;
  font-weight: 600;
}
.tab-item.active .tab-icon {
  text-shadow: 0 0 14rpx rgba(99, 230, 247, 0.72);
  animation: tabPop 2.8s ease-in-out infinite;
}

@keyframes tabPop {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-4rpx);
  }
}
